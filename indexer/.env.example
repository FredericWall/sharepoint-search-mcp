# Local OneDrive/SharePoint synchronization root. Keep Windows paths in single quotes.
LOCAL_ROOT='C:\Users\your-user\OneDrive - Your Organization\Knowledge Base'
LOCAL_PREFIX='C:\Users\your-user\OneDrive - Your Organization\Knowledge Base'

# SharePoint path represented by LOCAL_PREFIX and the site used for clickable links.
SHAREPOINT_PREFIX='/sites/your-site/Shared Documents/Knowledge Base'
SITE_URL='https://contoso.sharepoint.com/sites/your-site'

# PostgreSQL credentials are injected in memory by the PowerShell runner.
INDEX_BACKEND=postgres
POSTGRES_SCHEMA=sharepoint_mcp

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
MIN_TEXT_CHARACTERS=20
EXCLUDE_DIRS=99_Archive_Jun2nd
